{
  "name": "gbcheeseage-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 22824",
    "test:reshuffle": "esbuild scripts/test-reshuffle.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-reshuffle.mjs && node node_modules/.cache/test-reshuffle.mjs",
    "test:reshuffle:store": "esbuild scripts/test-reshuffle-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-reshuffle-store.mjs && node node_modules/.cache/test-reshuffle-store.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
